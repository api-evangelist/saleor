          },
          "docs": "GraphQL query passed via query parameters per GraphQL-over-HTTP."
        },
        {
          "info": {
            "name": "Execute GraphQL query or mutation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{store}.saleor.cloud/graphql/",
            "body": {
              "type": "json",
